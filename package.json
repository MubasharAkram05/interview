{
  "name": "interview-simulator",
  "version": "1.0.0",
  "description": "Interview Simulator Android App with Capacitor and AdMob",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:sync": "npx cap sync android",
    "android:prep": "npm run build && npx cap sync android",
    "policy:page": "node scripts/build-policy-page.mjs",
    "assets": "npx capacitor-assets generate --android",
    "store:assets": "node scripts/make-store-assets.mjs",
    "icon": "node scripts/make-icon.mjs",
    "policy:check": "node scripts/check-policy-sync.mjs",
    "test:ads": "node --import ./tests/ads/reg.mjs tests/ads/interstitial.test.mjs",
    "test:home": "node tests/home/qotd.test.mjs",
    "test:voice": "node tests/voice/readalong.test.mjs && node tests/voice/filter.test.mjs && node --import ./tests/voice/reg.mjs tests/voice/voice.test.mjs",
    "test:vocab": "node tests/vocab/vocab.test.mjs && node tests/vocab/false-positives.test.mjs",
    "build:debug": "vite build --mode debug"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.23",
    "double-metaphone": "^2.0.1",
    "fastest-levenshtein": "^1.0.16",
    "localforage": "^1.10.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "vite": "^8.3.4",
    "wordlist-english": "^1.2.1"
  }
}
