{
  "name": "interview-simulator",
  "version": "1.0.0",
  "description": "Interview Simulator Android App with Capacitor and AdMob",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:sync": "npx cap sync android",
    "android:prep": "npm run build && npx cap sync android",
    "policy:page": "node scripts/build-policy-page.mjs",
    "store:assets": "node scripts/make-store-assets.mjs",
    "store:screens": "node scripts/make-screenshots.mjs",
    "icon": "node scripts/make-icon.mjs",
    "icon:check": "node scripts/check-icons.mjs",
    "policy:check": "node scripts/check-policy-sync.mjs",
    "test:ads": "node --import ./tests/ads/reg.mjs tests/ads/interstitial.test.mjs",
    "test:home": "node tests/home/qotd.test.mjs",
    "test:voice": "node tests/voice/filter.test.mjs && node --import ./tests/voice/reg.mjs tests/voice/voice.test.mjs && node --import ./tests/storage/reg.mjs tests/voice/prefs.test.mjs",
    "test:vocab": "node tests/vocab/vocab.test.mjs && node tests/vocab/interview-vocab.test.mjs",
    "test:practice": "node tests/practice/expected.test.mjs && node tests/practice/setup.test.mjs && node tests/practice/categories.test.mjs",
    "build:debug": "vite build --mode debug",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js capacitor.config.ts",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js capacitor.config.ts",
    "test:storage": "node --import ./tests/storage/reg.mjs tests/storage/storage.test.mjs",
    "test": "npm run test:ads && npm run test:home && npm run test:voice && npm run test:vocab && npm run test:practice && npm run test:storage",
    "test:smoke": "node scripts/smoke.mjs",
    "test:coverage": "c8 --include=\"src/**\" --exclude=\"src/data/**\" --reporter=text-summary npm test",
    "test:ui": "node tests/ui/home-ui.mjs && node tests/ui/voice-ui.mjs && node tests/ui/regress-ui.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.23",
    "double-metaphone": "^2.0.1",
    "fastest-levenshtein": "^1.0.16",
    "localforage": "^1.10.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "wordlist-english": "^1.2.1"
  }
}
