<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app's own pages load from https://localhost (Capacitor), ads and speech use
     Google's HTTPS endpoints. No plain HTTP anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
